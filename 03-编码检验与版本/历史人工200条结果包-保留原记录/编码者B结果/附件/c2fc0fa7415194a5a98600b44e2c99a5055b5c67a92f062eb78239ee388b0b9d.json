      "text_sha256": "ca84e60d8e8f4582ac3be92e5d79a278e94e7639449ff1eed58e8d2991527508"
    },
    {
      "source_paragraph_id": "CARE-P116",
      "physical_pages": [
        16
      ],
      "text": "试验分期",
      "text_sha256": "dac5b7ae359efa8e3744ea1fbd1006431714779fe220eb721d3c403232bc5871"
    },
    {
      "source_paragraph_id": "CARE-P117",
      "physical_pages": [
        16
      ],
      "text": "研究设计",
      "text_sha256": "2632b1c12f58c5f35acc437b93aef3d741e47f490d23691d545225696bd4bbaa"
    },
    {
      "source_paragraph_id": "CARE-P118",
      "physical_pages": [
        16
      ],
      "text": "研究内容",
      "text_sha256": "f1c769b9939cfce5be69bde45c51d4d391dc0b8e9f3f56f171a4e9561320b0a4"
    },
    {
      "source_paragraph_id": "CARE-P119",
      "physical_pages": [
        16
      ],
      "text": "研究人群",
      "text_sha256": "ff2e9948993ed4f93e47c8e814ac4da05ec40792d29bcbce44bc083a8c1803ef"
    },
    {
      "source_paragraph_id": "CARE-P120",
      "physical_pages": [
        16
      ],
      "text": "对罕见疾病适应症开发的指导作用",
      "text_sha256": "9f2bceaa05caf26fa080f4c55decbde2a28a4b84628513924feb13ebd7e71a39"
    },
    {
      "source_paragraph_id": "CARE-P121",
      "physical_pages": [
        16
      ],
      "text": "I期",
      "text_sha256": "c353bddcdf38cccd22df296366f4ef95a216ced169cb3fa8571aa88322bbe58a"
    },
    {
      "source_paragraph_id": "CARE-P122",
      "physical_pages": [
        16
      ],
      "text": "单臂、单次给药",
      "text_sha256": "d762ccca60ef7df133581e0edf6461479729b286a08202937f00b94f75532f4c"
    },
    {
      "source_paragraph_id": "CARE-P123",
      "physical_pages": [
        16
      ],
      "text": "PK",
      "text_sha256": "fcab7fcc2b4cffd9bb45003bfc2e468a04ef6f77ca8200a7341f027631584d25"
    },
    {
      "source_paragraph_id": "CARE-P124",
      "physical_pages": [
        16
      ],
      "text": "健康受试者",
      "text_sha256": "ef0cdca0c9599a356d305fd5cc987c536d57959c5b0d93e20ac757ddf683c8bd"
    },
    {
      "source_paragraph_id": "CARE-P125",
      "physical_pages": [
        16
      ],
      "text": "获取PK数据，指导后续临床给药方案",
      "text_sha256": "206e0271b6429e517d89167b8e60672a711689be4bcb70aa5290f1888d3ac9e8"
    },
    {
      "source_paragraph_id": "CARE-P126",
      "physical_pages": [
        16
      ],
      "text": "II期",
      "text_sha256": "9dc525d3a9a95ab6ede6c0ac80887947ce8b380d9e1b3c4412a0f392210d8985"
    },
    {
      "source_paragraph_id": "CARE-P127",
      "physical_pages": [
        16
      ],
      "text": "单臂、多次给药",
      "text_sha256": "81f629a2f451587cbbe3993923ac932187c6e182e6601610bbf9c421e84bf162"
    },
    {
      "source_paragraph_id": "CARE-P128",
      "physical_pages": [
        16
      ],
      "text": "PK、有效性、安全性",
      "text_sha256": "75e14743fb931b0fd7867e2fdae007e171a86c5a2870d77d0232f2a67cb4084f"
    },
    {
      "source_paragraph_id": "CARE-P129",
      "physical_pages": [
        16
      ],
      "text": "适应症A人群（非罕见疾病）",
      "text_sha256": "3188e3f58bbabc403856a8c4f68b37bc04efa6f3de8bc5c9d0d423a9be17f6d1"
    },
    {
      "source_paragraph_id": "CARE-P130",
      "physical_pages": [
        16
      ],
      "text": "建立PK-PD相关性，为罕见疾病适应症的给药方案提供支持性依据",
      "text_sha256": "dea4e7bf62b78062147507e33085f37e50a69568d399061827e1b415a62a9473"
    },
    {
      "source_paragraph_id": "CARE-P131",
      "physical_pages": [
        16
      ],
      "text": "Ib/II期",
      "text_sha256": "345c1b2b87d386eb154221de2bd9500b41313a25fa7c8f4a75c43bf948b043fc"
    },
    {
      "source_paragraph_id": "CARE-P132",
      "physical_pages": [
        16
      ],
      "text": "单臂、多次给药",
      "text_sha256": "81f629a2f451587cbbe3993923ac932187c6e182e6601610bbf9c421e84bf162"
    },
    {
      "source_paragraph_id": "CARE-P133",
      "physical_pages": [
        16
      ],
      "text": "PK、有效性、安全性",
      "text_sha256": "75e14743fb931b0fd7867e2fdae007e171a86c5a2870d77d0232f2a67cb4084f"
    },
    {
      "source_paragraph_id": "CARE-P134",
      "physical_pages": [
        16
      ],
      "text": "适应症B人群（罕见疾病）",
      "text_sha256": "277a405233eb918a0d5e5cd76c686d1fedb6803f793d914a4b7e429eaa13b026"
    },
    {
      "source_paragraph_id": "CARE-P135",
      "physical_pages": [
        16
      ],
      "text": "Ib期在目标适应症中进行初步探索，II期作为关键研究",
      "text_sha256": "33c3205fa086085e806ad1721b2d8625e157f1eaba0e532c038a8f2b6405ef57"
    },
    {
      "source_paragraph_id": "CARE-P136",
      "physical_pages": [
        16
      ],
      "text": "III期",
      "text_sha256": "ad66f64d452071aa512ab5e12b1e8388e20d06f19aeeaf1427c72fd619393984"
    },
    {
      "source_paragraph_id": "CARE-P137",
      "physical_pages": [
        16
      ],
      "text": "安慰剂对照",
      "text_sha256": "e2086353e79ff17acc837333d2af758827da475d129f245e253a94bd1c51bdf4"
    },
    {
      "source_paragraph_id": "CARE-P138",
      "physical_pages": [
        16
      ],
      "text": "有效性、安全性",
      "text_sha256": "57496dcac6397141b52db2cc3c06645af3085a19eff8982547231de8e8b8b312"
    },
    {
      "source_paragraph_id": "CARE-P139",
      "physical_pages": [
        16
      ],
      "text": "适应症A人群（非罕见疾病）",
      "text_sha256": "3188e3f58bbabc403856a8c4f68b37bc04efa6f3de8bc5c9d0d423a9be17f6d1"
    },
    {
      "source_paragraph_id": "CARE-P140",
      "physical_pages": [
        16
      ],
      "text": "为罕见疾病适应症的上市提供更多的安全性数据",
      "text_sha256": "9f0070f58e51d252f7631125eff4aef54ba4dfea8cc3e2ebc7ebdfc1a85b8649"
    }
  ],
